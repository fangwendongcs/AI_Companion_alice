# Configuration placeholders only. `npm run dev` loads a local root `.env` when present.
# Keep `.env` Git-ignored; deployment should use platform Environment Variables / Secret Manager.

# Server / deployment mode
# local: developer machine with safe defaults.
# demo: private preview; set ALLOWED_ORIGINS and REQUIRE_API_AUTH=true.
# production: public deployment candidate; strict validation is required.
PORT=3000
DEPLOYMENT_MODE=local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_LOCALHOST=true

# API authentication
# Required for demo/private preview and production-like deployments.
REQUIRE_API_AUTH=false
API_AUTH_TOKEN=replace_with_private_token

# Request and upload limits
JSON_BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=80mb
AVATAR_UPLOAD_MAX_MB=80

# Upload isolation
# Keep UPLOAD_STORAGE_DIR outside public assets. Publish only validated files to AVATAR_ASSET_DIR.
UPLOAD_STORAGE_DIR=data/uploads/quarantine
UPLOAD_TMP_DIR=data/uploads/tmp
PUBLIC_ASSET_DIR=public
AVATAR_ASSET_DIR=public/avatars
UPLOAD_MAX_TOTAL_BYTES=500mb
UPLOAD_MAX_FILES=200

# Local SQLite memory foundation
# The database file is local runtime data and must not be committed.
SQLITE_DIR=data/sqlite
SQLITE_DB_PATH=data/sqlite/alice.db

# Lightweight single-instance rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
RATE_LIMIT_SENSITIVE_MAX_REQUESTS=60
UPSTREAM_TIMEOUT_MS=45000
TTS_UPSTREAM_TIMEOUT_MS=90000
# /api/dialogue 默认在真实 LLM 配置/上游失败时返回安全的本地 stub 回复。
# 仅将此开关设为 false 才会把安全 LLM 错误直接返回给 /api/dialogue 调用方。
DIALOGUE_FALLBACK_TO_STUB=true
# Local/evaluation only. When true outside production, meta.llmDiagnostics exposes only finish reason and token counts.
DIALOGUE_DEBUG_LLM_DIAGNOSTICS=false
N8N_TIMEOUT_MS=8000

# LLM / OpenAI-compatible providers
# Default browser-visible provider is stub, so these keys are optional for local demo.
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=replace_with_your_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Shared OpenAI-compatible completion limit. Override only in the backend environment.
LLM_MAX_TOKENS=320
# custom 默认也要求后端 API Key；只有受控的无鉴权 OpenAI-compatible 服务才设为 true。
CUSTOM_API_KEY_OPTIONAL=false
CUSTOM_API_KEY=replace_with_your_key
CUSTOM_BASE_URL=https://api.example.com/v1
# 无 Key OpenAI-compatible 示例（不新增 Ollama adapter）：
# CUSTOM_API_KEY_OPTIONAL=true
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=replace_with_your_key

# TTS
# Runtime default provider is backend-only. Clients should not see service URLs or keys.
TTS_PROVIDER=mock
TTS_OUTPUT_FORMAT=mp3
MINIMAX_API_KEY=replace_with_your_key
MINIMAX_BASE_URL=https://api.minimax.io/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
MINIMAX_TTS_MODEL=speech-2.8-hd

# Qwen3-TTS hosted by Alibaba Cloud Model Studio / DashScope.
# Use the base URL and API key for the same region. DASHSCOPE_API_KEY or the existing
# backend-only QWEN_API_KEY is accepted as a fallback when it belongs to that region.
QWEN3_TTS_API_KEY=replace_with_your_key
QWEN3_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
QWEN3_TTS_PATH=/services/aigc/multimodal-generation/generation
QWEN3_TTS_MODEL=qwen3-tts-flash
QWEN3_TTS_VOICE=Cherry
QWEN3_TTS_LANGUAGE_TYPE=Chinese
QWEN3_TTS_OUTPUT_FORMAT=wav
QWEN3_TTS_SAMPLE_RATE=24000

# Fish Audio native cloud API. Voice is the Fish Audio reference_id / voice model id.
FISH_AUDIO_API_KEY=replace_with_your_key
FISH_AUDIO_TTS_BASE_URL=https://api.fish.audio
FISH_AUDIO_TTS_PATH=/v1/tts
FISH_AUDIO_TTS_MODEL=s2.1-pro-free
FISH_AUDIO_TTS_VOICE=replace_with_voice_model_id
FISH_AUDIO_TTS_OUTPUT_FORMAT=mp3
FISH_AUDIO_TTS_SAMPLE_RATE=44100
FISH_AUDIO_TTS_LATENCY=balanced

# CosyVoice2 local/open-source mainline
COSYVOICE_BASE_URL=
COSYVOICE_API_STYLE=official_fastapi
COSYVOICE_API_MODE=sft
COSYVOICE_SPEECH_PATH=
COSYVOICE_MODEL=iic/CosyVoice2-0.5B
COSYVOICE_VOICE_ID=中文女
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_PROMPT_TEXT=
COSYVOICE_PROMPT_WAV=
COSYVOICE_INSTRUCT_TEXT=
COSYVOICE_API_KEY=replace_with_optional_key

# Higgs Audio v3 experimental provider
HIGGS_BASE_URL=
HIGGS_SPEECH_PATH=/v1/audio/speech
HIGGS_MODEL=higgs-audio-v3
HIGGS_VOICE_ID=alice
HIGGS_API_KEY=replace_with_optional_key

# Optional workflow / future integrations
# n8n is only called by the backend when /api/dialogue options.useWorkflow=true.
N8N_WEBHOOK_URL=https://example.invalid/webhook
N8N_WEBHOOK_SECRET=replace_with_your_secret
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace_with_your_key
QDRANT_COLLECTION=example_collection
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=replace_with_your_key
RAG_PROVIDER=example_provider
RAG_COLLECTION=example_collection
MEMORY_STORE=example_store
AGENT_PROVIDER=example_provider
AGENT_MODEL=example_model
