{
  "id": "local_boy_vrm_test",
  "name": "Boy VRM（local）",
  "type": "humanoid-vrm",
  "model": {
    "url": "assets/avatars/test-vrm/boy.vrm",
    "format": "vrm"
  },
  "renderer": {
    "type": "vrm",
    "fallback": "default",
    "expressionMap": {
      "happy": ["happy", "joy", "smile", "fun", "relaxed", "fcl_all_joy", "fcl_mth_joy", "fcl_eye_joy", "fcl_all_fun", "fcl_mth_fun"],
      "sad": ["sad", "sorrow", "trouble", "fcl_all_sorrow", "fcl_mth_sorrow"],
      "blink": ["blink", "eyeclose", "eye_close", "fcl_eye_close"],
      "mouth": ["mouth", "aa", "ah", "oh", "ou", "viseme", "fcl_mth", "fcl_mouth"]
    }
  },
  "capabilities": {
    "states": ["idle", "listening", "thinking", "speaking"],
    "emotions": ["neutral", "warm", "happy", "sad", "concerned"],
    "gestures": ["none", "soft_nod", "thinking", "wave"],
    "gaze": ["user", "away", "down"],
    "lipSync": ["none", "auto", "basic"],
    "expressions": ["neutral", "happy", "sad", "blink"],
    "renderer": "vrm"
  },
  "motionManifest": "assets/avatars/test-vrm/motions.json",
  "skeleton": {
    "type": "humanoid",
    "map": "assets/avatars/test-vrm/skeleton.mixamo.json"
  },
  "skeletonMap": "assets/avatars/test-vrm/skeleton.mixamo.json",
  "animations": {
    "manifest": "assets/avatars/test-vrm/motions.json",
    "standardSlots": true
  },
  "transform": {
    "targetHeight": 128,
    "position": { "x": 0, "y": 0, "z": 0 },
    "rotation": { "x": 0, "y": 3.141592653589793, "z": 0 },
    "scale": 1
  },
  "camera": {
    "targetY": 92,
    "minDistance": 100,
    "maxDistance": 620
  },
  "hitRegions": {
    "head": ["head", "neck", "headtop"],
    "arm": ["arm", "hand", "shoulder", "forearm"],
    "leg": ["leg", "foot", "toe", "upleg"]
  },
  "interactions": {
    "head": { "motionIntent": "interaction.headTap", "motionSlot": "headTap" },
    "leg": { "motionIntent": "interaction.legTap", "motionSlot": "legTap" },
    "arm": { "motionIntent": "interaction.greeting", "motionSlot": "armTap" },
    "body": { "motionIntent": "interaction.tap", "motionSlot": "bodyTap" },
    "chat": { "motionIntent": "interaction.chat", "motionSlot": "chat" }
  },
  "voice": {
    "defaultEngine": "browser"
  },
  "localTest": {
    "enabledBy": "?debug=1 or ?localVrm=1",
    "commitModelFile": false,
    "licenseStatus": "local-only; verify before promotion"
  }
}
